# ==============================================
# MessMate - Environment Configuration Template
# ==============================================

# Server Environment
PORT=5000
NODE_ENV=development

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-messmate-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL / Cloud PostgreSQL)
# Example Supabase: postgresql://[user].[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=messmate&sslmode=require
DATABASE_URL="postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=messmate&sslmode=require"
DIRECT_URL="postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=messmate&sslmode=require"

# Supabase API (Optional for MCP / Client SDK)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="[your-anon-or-publishable-key]"

# Logging
LOG_LEVEL=debug
