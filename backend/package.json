{
  "name": "messmate-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for MessMate SaaS",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:push": "node ./node_modules/prisma/build/index.js db push",
    "prisma:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "backup": "node ./node_modules/tsx/dist/cli.mjs src/scripts/backup_database.ts",
    "verify-backup": "node ./node_modules/tsx/dist/cli.mjs src/scripts/verify_backup_integrity.ts",
    "migrate:multi-tenant": "node ./node_modules/tsx/dist/cli.mjs src/scripts/migrateMultiTenantData.ts",
    "test": "node ./node_modules/vitest/vitest.mjs run --no-file-parallelism"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.6",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.22.0",
    "supertest": "^7.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
